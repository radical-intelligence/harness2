# Copy this file to .env and fill in the values you need. Shell environment
# variables take precedence over .env. Leave a value empty to keep its default.
# See docs/SETUP.md for details.

# --- Google Cloud (Vertex AI) ---
# Project for Vertex AI models. Needed when any model below runs on Vertex.
# HARNESS2_VERTEX_PROJECT is accepted as an alternative name.
GOOGLE_CLOUD_PROJECT=
# Vertex AI region. Defaults to "global".
GOOGLE_CLOUD_LOCATION=

# --- Models ---
# Executor model (runs the task agent) in OpenCode's provider/model format,
# for example google-vertex/<model-id>.
HARNESS2_SOLVER_MODEL=
# Improver model (runs the editor, composer, selector and reflector agents),
# same format. Defaults to the executor model.
HARNESS2_IMPROVER_MODEL=
# Judge model, as a bare model ID. The benchmark adapter adds any prefix it needs.
HARNESS2_JUDGE_MODEL=

# --- Judge endpoint (optional) ---
# Set both to send JobBench judging to an OpenAI-compatible endpoint instead of
# Vertex AI.
HARNESS2_JUDGE_BASE_URL=
HARNESS2_JUDGE_API_KEY=

# --- Codex executor (only with --substrate cx) ---
# harness2-bridge prints the values for these when it starts.
# Model ID served by the Responses API endpoint. Defaults to the executor model
# without its provider prefix.
HARNESS2_CODEX_MODEL=
# Responses API endpoint for Codex on this machine.
HARNESS2_CODEX_BASE_URL=
# Access key for that endpoint.
HARNESS2_CODEX_API_KEY=
# The same endpoint as reached from inside WorkBuddy-Bench's Docker containers.
# Defaults to HARNESS2_CODEX_BASE_URL.
HARNESS2_CODEX_CONTAINER_URL=

# --- Output ---
# Where runs, libraries and results are written. Defaults to runs/.
HARNESS2_RUNS_DIR=
